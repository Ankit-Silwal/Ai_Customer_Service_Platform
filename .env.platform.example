# Copy to .env.platform, replace every placeholder, then run:
# docker compose --env-file .env.platform -f compose.infra.yml up -d
RELAY_DB_PASSWORD=replace-with-a-random-local-password
DATABASE_URL=postgresql://relay:replace-with-a-random-local-password@localhost:5440/relay
INTERNAL_SECRET=replace-with-a-random-secret-of-at-least-32-characters
WEB_ORIGIN=http://localhost:3000
PORT=4100
KNOWLEDGE_URL=http://localhost:4101
S3_ENDPOINT=http://localhost:9100
S3_ACCESS_KEY=relay-storage
S3_SECRET_KEY=replace-with-a-random-storage-password
S3_BUCKET=relay-documents
# Optional: without a key, chat returns clearly labelled source previews.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4.1-mini
AI_EMBEDDING_MODEL=text-embedding-3-small
NODE_ENV=development
